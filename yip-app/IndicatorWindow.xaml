<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="yip.IndicatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root" Background="Transparent">
        <!--
            The window is the pill: IndicatorWindow::SyncWindowToState sizes the
            HWND and this Border together, per state, around a fixed anchor so
            the capsule stays centred where it was placed. Size and radius are
            set from code before the first show.
        -->
        <Border
            x:Name="PillFrame"
            Background="{ThemeResource YipIndicatorSurfaceBrush}"
            BorderBrush="{ThemeResource YipIndicatorStrokeQuietBrush}"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            ManipulationMode="TranslateX,TranslateY"
            PointerPressed="OnPillPointerPressed"
            PointerMoved="OnPillPointerMoved"
            PointerReleased="OnPillPointerReleased"
            PointerCaptureLost="OnPillPointerCaptureLost"
            Tapped="OnPillTapped">

            <Grid x:Name="PillContent" Padding="{StaticResource YipIndicatorPadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />     <!-- readout, centred in what is left -->
                    <ColumnDefinition Width="Auto" />  <!-- expanded actions -->
                </Grid.ColumnDefinitions>

                <!-- Dot, meter and clock travel as one group. With the actions
                     collapsed the star column is the whole pill, so the group sits
                     dead centre; expanded, it centres in the space left of them. -->
                <StackPanel x:Name="ReadoutGroup"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <!-- Dot host — its Visual receives a SpriteVisual fill. -->
                    <Border x:Name="DotHost"
                            Width="12" Height="12"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center" />

                    <!-- Meter host — 4 bars appended as child visuals. Exactly as
                         wide as the bars, or the group centres off to one side. -->
                    <Border x:Name="MeterHost"
                            Width="24" Height="22"
                            VerticalAlignment="Center"
                            Opacity="0" />

                    <!-- Elapsed time. The pill is often the only thing on screen
                         while recording, so it answers "how long has this been
                         running" without opening the main window. -->
                    <TextBlock x:Name="ElapsedText"
                               Text="00:00"
                               FontFamily="Cascadia Mono,Consolas,Courier New"
                               FontSize="13"
                               Foreground="{ThemeResource YipIndicatorTimerBrush}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Opacity="0"
                               AutomationProperties.Name="Elapsed recording time" />
                </StackPanel>

                <StackPanel x:Name="ExpandedActions"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                    <StackPanel.Resources>
                        <!-- Round glass buttons, as drawn in .design/Pill.dc.html. -->
                        <Style x:Key="PillActionButton" TargetType="Button">
                            <Setter Property="Width" Value="34" />
                            <Setter Property="Height" Value="34" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="CornerRadius" Value="17" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Background" Value="{ThemeResource YipIndicatorActionFillBrush}" />
                            <Setter Property="BorderBrush" Value="{ThemeResource YipIndicatorActionStrokeBrush}" />
                            <Setter Property="Foreground" Value="{ThemeResource YipIndicatorActionInkBrush}" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </StackPanel.Resources>
                    <!-- Hold before stop: pausing is the recoverable one, so it
                         takes the inner slot where the thumb lands first, and
                         the irreversible button is the one further out. -->
                    <Button x:Name="PauseButton"
                            Style="{StaticResource PillActionButton}"
                            Click="OnPauseClicked"
                            AutomationProperties.Name="Pause"
                            ToolTipService.ToolTip="Pause">
                        <FontIcon x:Name="PauseGlyph"
                                  FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE769;"
                                  FontSize="13" />
                    </Button>
                    <Button x:Name="StopButton"
                            Style="{StaticResource PillActionButton}"
                            Click="OnStopClicked"
                            AutomationProperties.Name="Stop"
                            ToolTipService.ToolTip="Stop">
                        <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2"
                                   Fill="{ThemeResource YipIndicatorActionInkBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
