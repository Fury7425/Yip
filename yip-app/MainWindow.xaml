<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="yip.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:yip.viewmodels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <!-- The backdrop is set in App::OnLaunched (Mica, falling back to acrylic
         where Mica is unsupported). Nothing here paints an opaque fill: every
         surface is a tint over that backdrop, so the desktop reads through and
         the extended title bar is continuous with the content. -->
    <!-- Placement Hidden: these are window-wide shortcuts, but WinUI hangs the
         first one's key tip ("Ctrl+R") off whatever element owns them, so it
         popped up over any bare stretch of the window, caption buttons included. -->
    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnRecordAccelerator" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAccelerator" />
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="OnPlayAccelerator" />
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Title bar ===================== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44" Background="Transparent"
              Padding="18,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <!-- The mark doubles as the recording lamp: it is the one thing
                     visible no matter how the window is sized. -->
                <Ellipse x:Name="TitleLamp" Width="8" Height="8" />
                <TextBlock Text="Yip"
                           FontSize="{StaticResource YipFontBody}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource YipTextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="TitleBarActions" Grid.Column="2" Orientation="Horizontal"
                        Spacing="2" Margin="0,0,140,0" VerticalAlignment="Center">
                <Button x:Name="SettingsButton" Click="OnOpenSettings"
                        Background="Transparent" BorderThickness="0" Padding="9,6"
                        AutomationProperties.Name="Settings"
                        ToolTipService.ToolTip="Settings">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="15" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== Error surface ===================== -->
        <InfoBar x:Name="ErrorBar"
                 Grid.Row="1"
                 Severity="Error"
                 IsOpen="False"
                 Margin="16,0,16,10"
                 Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                 CloseButtonClick="OnDismissError" />

        <!-- ===================== Transport ===================== -->
        <Border Grid.Row="2"
                Margin="16,2,16,0"
                Padding="16,14,16,16"
                CornerRadius="{StaticResource YipCardCornerRadius}"
                Background="{ThemeResource YipCardBrush}"
                BorderBrush="{ThemeResource YipCardStrokeBrush}"
                BorderThickness="1">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Device + format -->
                <!-- The device name gives way, not the format: a long
                     endpoint name already ellipsizes inside the picker, but a
                     clipped "MP3 320…" hides the setting it reports. -->
                <Grid Grid.Row="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="DeviceCombo"
                        PlaceholderText="Select input device"
                        HorizontalAlignment="Left"
                        MaxWidth="420"
                        Height="{StaticResource YipPillHeight}"
                        CornerRadius="{StaticResource YipPillCornerRadius}"
                        Background="{ThemeResource YipControlFillBrush}"
                        BorderBrush="{ThemeResource YipControlStrokeBrush}"
                        BorderThickness="1"
                        PlaceholderForeground="{ThemeResource YipTextTertiaryBrush}"
                        ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedDeviceIndex, Mode=TwoWay}"
                        AutomationProperties.Name="Input device">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceEntry">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0"
                                              FontFamily="Segoe Fluent Icons"
                                              Glyph="{x:Bind Glyph}"
                                              FontSize="14"
                                              VerticalAlignment="Center"
                                              Opacity="0.8" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind ViewModel.FormatLabel, Mode=OneWay}"
                               FontSize="{StaticResource YipFontMicro}"
                               CharacterSpacing="40"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource YipTextTertiaryBrush}" />
                </Grid>

                <!-- Elapsed clock -->
                <TextBlock x:Name="ElapsedLabel"
                           Grid.Row="1"
                           Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}"
                           FontFamily="Cascadia Mono,Consolas,Courier New"
                           FontSize="{StaticResource YipFontTimer}"
                           FontWeight="Light"
                           TextAlignment="Center"
                           Opacity="0.55"
                           Foreground="{ThemeResource YipTextPrimaryBrush}"
                           AutomationProperties.Name="Elapsed recording time">
                    <!-- The clock brightens when a take starts rather than
                         snapping: it is the state change you are watching. -->
                    <TextBlock.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.2" />
                    </TextBlock.OpacityTransition>
                </TextBlock>

                <!-- Waveform. The bars and the peak-hold line are composition
                     visuals parented to this Grid, so a level update never
                     touches XAML layout; the gridlines below are static. -->
                <Grid Grid.Row="2"
                      x:Name="WaveHost"
                      Height="{StaticResource YipWaveHeight}"
                      CornerRadius="{StaticResource YipMeterCornerRadius}"
                      Background="{ThemeResource YipMeterTrackQuietBrush}"
                      SizeChanged="OnWaveSizeChanged"
                      AutomationProperties.Name="Input level">
                    <Rectangle Height="1" VerticalAlignment="Center" Margin="10,0,10,0"
                               Fill="{ThemeResource YipWaveBaselineBrush}" />
                </Grid>

                <!-- Readouts -->
                <Grid Grid.Row="3" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="PEAK" FontSize="9" CharacterSpacing="110"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource YipTextTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.PeakLabel, Mode=OneWay}"
                                   FontFamily="Cascadia Mono,Consolas,Courier New"
                                   FontSize="{StaticResource YipFontCaption}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource YipTextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <TextBlock Text="RMS" FontSize="9" CharacterSpacing="110"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource YipTextTertiaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.RmsLabel, Mode=OneWay}"
                                   FontFamily="Cascadia Mono,Consolas,Courier New"
                                   FontSize="{StaticResource YipFontCaption}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource YipTextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="ClipLamp" Grid.Column="3" Spacing="3" Opacity="0.18"
                                Tapped="OnAcknowledgeClip"
                                ToolTipService.ToolTip="Clipping detected. Click to reset."
                                AutomationProperties.Name="Clip indicator">
                        <StackPanel.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.15" />
                        </StackPanel.OpacityTransition>
                        <Border Width="24" Height="3" CornerRadius="2"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource YipClipLitBrush}" />
                        <TextBlock Text="CLIP" FontSize="9" CharacterSpacing="110"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource YipClipLitBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Record -->
                <StackPanel Grid.Row="4" Spacing="5" HorizontalAlignment="Center">
                    <Button
                        x:Name="RecordButton"
                        Width="62" Height="62"
                        CornerRadius="31"
                        Padding="0"
                        Click="OnRecordToggle"
                        Background="{x:Bind ViewModel.RecordButtonBrush, Mode=OneWay}"
                        BorderBrush="{ThemeResource YipRecordStrokeBrush}"
                        BorderThickness="1"
                        IsEnabled="{x:Bind ViewModel.CanRecord, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.RecordButtonText, Mode=OneWay}"
                        AutomationProperties.Name="Start or stop recording"
                        CenterPoint="31,31,0">
                        <!-- Pointer presses scale this down (MainWindow::PressRecordButton);
                             keyboard activation deliberately does not. -->
                        <Button.ScaleTransition>
                            <Vector3Transition Duration="0:0:0.12" />
                        </Button.ScaleTransition>
                        <!-- The dot and the square crossfade with a scale instead of
                             swapping visibility, so the control reads as one thing
                             changing state rather than two glyphs trading places. -->
                        <Grid Width="22" Height="22">
                            <Ellipse x:Name="RecordDot"
                                     Fill="{ThemeResource YipRecordCoreBrush}"
                                     CenterPoint="11,11,0">
                                <Ellipse.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.16" />
                                </Ellipse.OpacityTransition>
                                <Ellipse.ScaleTransition>
                                    <Vector3Transition Duration="0:0:0.22" />
                                </Ellipse.ScaleTransition>
                            </Ellipse>
                            <Rectangle x:Name="StopSquare"
                                       Fill="{ThemeResource YipRecordCoreBrush}"
                                       Width="19" Height="19" RadiusX="5" RadiusY="5"
                                       Opacity="0"
                                       Scale="0.5,0.5,1"
                                       CenterPoint="9.5,9.5,0">
                                <Rectangle.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.16" />
                                </Rectangle.OpacityTransition>
                                <Rectangle.ScaleTransition>
                                    <Vector3Transition Duration="0:0:0.22" />
                                </Rectangle.ScaleTransition>
                            </Rectangle>
                        </Grid>
                    </Button>
                    <TextBlock Text="{x:Bind ViewModel.HotkeyLabel, Mode=OneWay}"
                               FontFamily="Cascadia Mono,Consolas,Courier New"
                               FontSize="9"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource YipTextTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Recordings ===================== -->
        <Border Grid.Row="3"
                Margin="16,10,16,0"
                CornerRadius="{StaticResource YipCardCornerRadius}"
                Background="{ThemeResource YipCardBrush}"
                BorderBrush="{ThemeResource YipCardStrokeBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="14,10,10,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Recordings"
                                   FontSize="{StaticResource YipFontSection}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource YipTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.RecordingsSummary, Mode=OneWay}"
                                   FontSize="{StaticResource YipFontCaption}"
                                   Foreground="{ThemeResource YipTextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="2"
                             Width="152"
                             Height="{StaticResource YipPillHeight}"
                             VerticalContentAlignment="Center"
                             CornerRadius="{StaticResource YipPillCornerRadius}"
                             Background="{ThemeResource YipControlFillBrush}"
                             BorderBrush="{ThemeResource YipControlStrokeBrush}"
                             BorderThickness="1"
                             PlaceholderText="Filter"
                             PlaceholderForeground="{ThemeResource YipTextTertiaryBrush}"
                             TextChanged="OnFilterChanged"
                             AutomationProperties.Name="Filter recordings"
                             ToolTipService.ToolTip="Filter recordings (Ctrl+F) · F5 refreshes" />
                </Grid>

                <Grid Grid.Row="1">
                    <ListView
                        x:Name="RecordingsList"
                        ItemsSource="{x:Bind ViewModel.Recordings, Mode=OneWay}"
                        SelectionMode="Single"
                        IsItemClickEnabled="True"
                        ItemClick="OnRecordingClick"
                        Padding="6,0,6,8"
                        AutomationProperties.Name="Recordings">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Margin" Value="0,1,0,1" />
                                <Setter Property="Padding" Value="10,6,10,6" />
                                <Setter Property="CornerRadius" Value="10" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecordingEntry">
                                <Grid ColumnSpacing="12" Background="Transparent">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Play" Click="OnPlayItem">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE768;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Open with default app"
                                                            Click="OnOpenExternallyItem">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8E5;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Show in Explorer" Click="OnRevealItem">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xEC50;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Copy path" Click="OnCopyPathItem">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8C8;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Delete" Click="OnDeleteItem">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind FileName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="{StaticResource YipFontCaption}" />
                                        <TextBlock Text="{x:Bind Subtitle}"
                                                   FontSize="{StaticResource YipFontMicro}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource YipTextTertiaryBrush}" />
                                    </StackPanel>

                                    <!-- Which row you are hearing. It keeps its
                                         width whether or not it is lit, so
                                         starting playback never reflows the
                                         list under the pointer. -->
                                    <FontIcon Grid.Column="1"
                                              FontFamily="Segoe Fluent Icons"
                                              Glyph="{x:Bind PlayGlyph, Mode=OneWay}"
                                              FontSize="11"
                                              Width="12"
                                              VerticalAlignment="Center"
                                              Opacity="{x:Bind PlayingOpacity, Mode=OneWay}"
                                              Foreground="{ThemeResource YipTextSecondaryBrush}">
                                        <FontIcon.OpacityTransition>
                                            <ScalarTransition Duration="0:0:0.15" />
                                        </FontIcon.OpacityTransition>
                                    </FontIcon>

                                    <StackPanel Grid.Column="2" Spacing="2" MinWidth="86">
                                        <TextBlock Text="{x:Bind Duration}"
                                                   FontFamily="Cascadia Mono,Consolas,Courier New"
                                                   FontSize="{StaticResource YipFontCaption}"
                                                   TextAlignment="Right"
                                                   Foreground="{ThemeResource YipTextSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ModifiedAt}"
                                                   FontSize="{StaticResource YipFontMicro}"
                                                   TextAlignment="Right"
                                                   Foreground="{ThemeResource YipTextTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="EmptyState"
                                Spacing="6"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D6;" FontSize="20"
                                  Foreground="{ThemeResource YipTextTertiaryBrush}" />
                        <TextBlock x:Name="EmptyStateText"
                                   Text="No recordings yet"
                                   FontSize="{StaticResource YipFontCaption}"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource YipTextSecondaryBrush}" />
                        <TextBlock x:Name="EmptyStateHint"
                                   Text="Press Record to make one."
                                   FontSize="{StaticResource YipFontMicro}"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource YipTextTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ===================== Playback ===================== -->
        <!-- Shown only while a take is loaded (MainWindow::UpdatePlaybackBar).
             Playback is native: this drives audio-core's play_* surface, not a
             shell handler. -->
        <Border x:Name="PlaybackBar"
                Grid.Row="4"
                Visibility="Collapsed"
                Margin="16,10,16,0"
                Padding="10,8,12,10"
                CornerRadius="{StaticResource YipCardCornerRadius}"
                Background="{ThemeResource YipCardBrush}"
                BorderBrush="{ThemeResource YipCardStrokeBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="PlayPauseButton"
                        Grid.Column="0"
                        Width="34" Height="34"
                        CornerRadius="17"
                        Padding="0"
                        Click="OnTogglePlayback"
                        Background="{ThemeResource YipControlFillBrush}"
                        BorderBrush="{ThemeResource YipControlStrokeBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Play or pause"
                        ToolTipService.ToolTip="Play / pause (Ctrl+P)">
                    <FontIcon x:Name="PlayPauseGlyph"
                              FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE769;"
                              FontSize="13" />
                </Button>

                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.PlayingFileName, Mode=OneWay}"
                                   FontSize="{StaticResource YipFontCaption}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource YipTextPrimaryBrush}" />
                        <!-- Output level, on the capture meter's own
                             logarithmic travel. -->
                        <ProgressBar Grid.Column="1"
                                     Width="44" Height="3"
                                     Minimum="0" Maximum="100"
                                     Value="{x:Bind ViewModel.PlaybackLevelPercent, Mode=OneWay}"
                                     Foreground="{ThemeResource YipPlaybackLevelBrush}"
                                     Background="{ThemeResource YipMeterTrackQuietBrush}"
                                     VerticalAlignment="Center"
                                     IsHitTestVisible="False"
                                     AutomationProperties.Name="Playback level" />
                    </Grid>

                    <Slider x:Name="SeekSlider"
                            Minimum="0"
                            Maximum="100"
                            StepFrequency="100"
                            Margin="0,-4,0,-8"
                            IsThumbToolTipEnabled="False"
                            ValueChanged="OnSeekChanged"
                            AutomationProperties.Name="Playback position" />
                </StackPanel>

                <!-- Three blocks rather than Runs: Run.Text is not a
                     dependency property, so x:Bind cannot reach it. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.PlaybackPositionText, Mode=OneWay}"
                               FontFamily="Cascadia Mono,Consolas,Courier New"
                               FontSize="{StaticResource YipFontCaption}"
                               Foreground="{ThemeResource YipTextSecondaryBrush}" />
                    <!-- Margin, not spaces: layout drops trailing
                         whitespace, which left "00:06 /00:56". -->
                    <TextBlock Text="/"
                               Margin="5,0"
                               FontFamily="Cascadia Mono,Consolas,Courier New"
                               FontSize="{StaticResource YipFontCaption}"
                               Foreground="{ThemeResource YipTextTertiaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.PlaybackDurationText, Mode=OneWay}"
                               FontFamily="Cascadia Mono,Consolas,Courier New"
                               FontSize="{StaticResource YipFontCaption}"
                               Foreground="{ThemeResource YipTextTertiaryBrush}" />
                </StackPanel>

                <Button x:Name="StopPlaybackButton"
                        Grid.Column="3"
                        Click="OnStopPlayback"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="7,6"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Stop playback"
                        ToolTipService.ToolTip="Stop playback">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </Border>

        <!-- ===================== Status bar ===================== -->
        <Grid Grid.Row="5" Padding="20,9,20,11">
            <TextBlock
                x:Name="StatusLine"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                FontSize="{StaticResource YipFontCaption}"
                TextTrimming="CharacterEllipsis"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource YipTextSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
