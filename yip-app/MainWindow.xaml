<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="yip.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:yip.viewmodels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title row -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Yip" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ProcessButton" Click="OnOpenProcess"
                        AutomationProperties.Name="Process"
                        ToolTipService.ToolTip="Process with VST3">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9F5;" FontSize="16" />
                </Button>
                <Button x:Name="SettingsButton" Click="OnOpenSettings"
                        AutomationProperties.Name="Settings"
                        ToolTipService.ToolTip="Settings">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Device + record -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox
                x:Name="DeviceCombo"
                PlaceholderText="Select input device"
                HorizontalAlignment="Stretch"
                MinWidth="280"
                ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.SelectedDeviceIndex, Mode=TwoWay}"
                AutomationProperties.Name="Input device">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceEntry">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      FontFamily="Segoe Fluent Icons"
                                      Glyph="{x:Bind Glyph}"
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      Opacity="0.8" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button
                x:Name="RecordButton"
                Grid.Column="1"
                MinWidth="120"
                Click="OnRecordToggle"
                Content="{x:Bind ViewModel.RecordButtonText, Mode=OneWay}"
                Background="{x:Bind ViewModel.RecordButtonBrush, Mode=OneWay}"
                Foreground="White"
                IsEnabled="{x:Bind ViewModel.CanRecord, Mode=OneWay}"
                AutomationProperties.Name="Record" />
        </Grid>

        <!-- Level meter -->
        <Border Grid.Row="2"
                CornerRadius="{StaticResource YipCardCornerRadius}"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                Padding="12,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Level"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Opacity="0.7" />
                <ProgressBar
                    Grid.Column="1"
                    x:Name="LevelMeter"
                    Minimum="0"
                    Maximum="1"
                    Value="{x:Bind ViewModel.PeakLevel, Mode=OneWay}"
                    Foreground="{StaticResource YipMeterFillBrush}"
                    Background="{StaticResource YipMeterTrackBrush}"
                    Height="10" />
                <TextBlock Grid.Column="2"
                           Text="{x:Bind ViewModel.PeakLabel, Mode=OneWay}"
                           FontFamily="Cascadia Mono,Consolas"
                           FontSize="12"
                           VerticalAlignment="Center"
                           MinWidth="48"
                           TextAlignment="Right"
                           Opacity="0.7" />
            </Grid>
        </Border>

        <!-- Recordings list -->
        <Border Grid.Row="3"
                CornerRadius="{StaticResource YipCardCornerRadius}"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Recordings" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Click="OnRefreshList"
                            ToolTipService.ToolTip="Refresh">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </Grid>
                <ListView
                    Grid.Row="1"
                    x:Name="RecordingsList"
                    ItemsSource="{x:Bind ViewModel.Recordings, Mode=OneWay}"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="OnRecordingClicked">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecordingEntry">
                            <Grid ColumnSpacing="12" Padding="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind FileName}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Duration}"
                                           VerticalAlignment="Center"
                                           Opacity="0.7"
                                           FontFamily="Cascadia Mono,Consolas"
                                           FontSize="12" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ModifiedAt}"
                                           VerticalAlignment="Center"
                                           Opacity="0.55"
                                           FontSize="12"
                                           MinWidth="120"
                                           TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Status bar -->
        <TextBlock
            Grid.Row="4"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            FontSize="12"
            Opacity="0.55" />
    </Grid>
</Window>
