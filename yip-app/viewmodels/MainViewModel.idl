namespace yip.viewmodels
{
    runtimeclass DeviceEntry
    {
        DeviceEntry();
        String Id;
        String Name;
        String Glyph;
        Boolean IsCapture;
        Boolean IsDefault;
    }

    runtimeclass RecordingEntry
    {
        RecordingEntry();
        String FullPath;
        String FileName;
        String Duration;
        String ModifiedAt;
        // "48 kHz · stereo · 32-bit float · 6.2 MB", read from the WAV header.
        String Subtitle;
    }

    [default_interface]
    runtimeclass MainViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        MainViewModel();

        Windows.Foundation.Collections.IObservableVector<DeviceEntry> Devices{ get; };
        Windows.Foundation.Collections.IObservableVector<RecordingEntry> Recordings{ get; };

        Int32 SelectedDeviceIndex;

        // Meter readings, already mapped onto the logarithmic meter scale
        // (0 = YipMeterFloorDb, 1 = full scale) so the view just draws them.
        Single MeterRms{ get; };
        Single MeterPeak{ get; };
        Single MeterHold{ get; };
        String PeakLabel{ get; };
        String RmsLabel{ get; };
        Boolean HasClipped{ get; };
        UInt32 DropoutCount{ get; };
        Boolean HasDropouts{ get; };

        // "00:00.0" while short, "1:02:03.4" past an hour.
        String ElapsedText{ get; };

        String StatusText{ get; };
        String ErrorText{ get; };
        Boolean HasError{ get; };

        String RecordButtonText{ get; };
        Microsoft.UI.Xaml.Media.Brush RecordButtonBrush{ get; };
        Boolean CanRecord{ get; };
        Boolean IsRecording{ get; };

        String OutputFolder{ get; };
        UInt32 SampleRate{ get; };
        UInt16 Channels{ get; };

        // Win32 MOD_* bitmask + virtual-key code for the global record hotkey.
        UInt32 HotkeyMods{ get; };
        UInt32 HotkeyVk{ get; };
        String HotkeyLabel{ get; };

        // Free-text filter over the recordings list. Setting it re-projects the
        // cached scan rather than re-reading the folder.
        String FilterText;
        Boolean IsEmpty{ get; };
        String RecordingsSummary{ get; };

        void RefreshDevices();
        void RefreshRecordings();

        // One poll of audio-core's meter snapshot. Replaces the old per-value
        // getters; costs a single FFI call.
        void Tick();

        void ToggleRecording();
        void ApplySettings(String folder, UInt32 sampleRate, UInt16 channels,
                           UInt32 hotkeyMods, UInt32 hotkeyVk);

        void RevealRecording(RecordingEntry entry);
        void OpenRecording(RecordingEntry entry);
        Boolean DeleteRecording(RecordingEntry entry);
        void CopyRecordingPath(RecordingEntry entry);

        // Reconcile the view model with audio-core's own state, for the paths
        // that end a session without going through ToggleRecording.
        void SyncRecordingState(Boolean recording);
        void ReportHotkeyConflict();
        void DismissError();
        void AcknowledgeClip();
    }
}
