{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 27, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Visual Studio 17 2022",
            "architecture": { "value": "x64", "strategy": "set" },
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
            }
        },
        {
            "name": "debug",
            "displayName": "x64 Debug",
            "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "release",
            "displayName": "x64 Release",
            "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "release-arm64",
            "displayName": "ARM64 Release",
            "inherits": "base",
            "architecture": { "value": "ARM64", "strategy": "set" },
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        }
    ],
    "buildPresets": [
        { "name": "debug",         "configurePreset": "debug",         "configuration": "Debug"   },
        { "name": "release",       "configurePreset": "release",       "configuration": "Release" },
        { "name": "release-arm64", "configurePreset": "release-arm64", "configuration": "Release" }
    ]
}
