<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="yip.ProcessDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    Title="Process recording"
    PrimaryButtonText="Render"
    SecondaryButtonText="Close"
    DefaultButton="Primary">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MinWidth="460" MaxHeight="520">
        <StackPanel Spacing="14">
            <StackPanel Spacing="6">
                <TextBlock Text="Source recording" FontWeight="SemiBold" Opacity="0.8" />
                <ComboBox x:Name="RecordingCombo" HorizontalAlignment="Stretch"
                          PlaceholderText="Select a .wav" />
            </StackPanel>

            <StackPanel Spacing="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Plugin chain" FontWeight="SemiBold" Opacity="0.8"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" x:Name="AddPluginButton" Content="Add…"
                            Click="OnAddPlugin" />
                    <Button Grid.Column="2" x:Name="RemovePluginButton" Content="Remove"
                            Click="OnRemovePlugin" />
                </Grid>
                <ListView x:Name="PluginList" SelectionMode="Single"
                          SelectionChanged="OnPluginSelectionChanged"
                          BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          CornerRadius="6" MinHeight="80" MaxHeight="140" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Parameters" FontWeight="SemiBold" Opacity="0.8" />
                <StackPanel x:Name="ParamHost" Spacing="10" />
                <TextBlock x:Name="ParamEmptyHint" Text="Select a plugin to edit parameters."
                           FontSize="12" Opacity="0.55" />
            </StackPanel>

            <StackPanel Spacing="4">
                <ProgressBar x:Name="RenderProgress" Minimum="0" Maximum="1" Value="0" />
                <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.7" Text="" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
