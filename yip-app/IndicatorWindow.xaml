<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="yip.IndicatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root" Background="Transparent">
        <!--
            Window HWND is fixed at 320x56 (YipIndicatorWindow{Width,Height}).
            The visible pill is the Border below, sized to the maximum state.
            We attach a Composition GeometricClip whose rounded-rectangle
            geometry animates to convey state changes — no XAML layout work
            during transitions. The clip lives on this Border's Visual.
        -->
        <Border
            x:Name="PillFrame"
            Width="{StaticResource YipIndicatorExpandedWidth}"
            Height="{StaticResource YipIndicatorExpandedHeight}"
            CornerRadius="{StaticResource YipIndicatorCornerRadius}"
            Background="{ThemeResource YipIndicatorSurfaceBrush}"
            BorderBrush="{ThemeResource YipIndicatorStrokeQuietBrush}"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            ManipulationMode="TranslateX,TranslateY"
            PointerPressed="OnPillPointerPressed"
            PointerMoved="OnPillPointerMoved"
            PointerReleased="OnPillPointerReleased"
            PointerCaptureLost="OnPillPointerCaptureLost"
            Tapped="OnPillTapped">

            <Grid x:Name="PillContent" Padding="{StaticResource YipIndicatorPadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />  <!-- dot / handle -->
                    <ColumnDefinition Width="Auto" />  <!-- meter (composition-hosted) -->
                    <ColumnDefinition Width="*" />     <!-- elapsed time -->
                    <ColumnDefinition Width="Auto" />  <!-- expanded buttons -->
                </Grid.ColumnDefinitions>

                <!-- Dot host — a 12x12 empty Border whose Visual receives a
                     SpriteVisual fill, animated by code-behind. -->
                <Border x:Name="DotHost"
                        Grid.Column="0"
                        Width="12" Height="12"
                        Margin="2,0,8,0"
                        VerticalAlignment="Center" />

                <!-- Meter host — 4 bars are appended as child visuals here. -->
                <Border x:Name="MeterHost"
                        Grid.Column="1"
                        Width="36" Height="22"
                        VerticalAlignment="Center"
                        Opacity="0" />

                <!-- Elapsed time. The pill is often the only thing on screen
                     while recording, so it has to answer "how long has this
                     been running" without opening the main window. -->
                <TextBlock x:Name="ElapsedText"
                           Grid.Column="2"
                           Text="00:00"
                           FontFamily="Cascadia Mono,Consolas,Courier New"
                           FontSize="13"
                           Foreground="{ThemeResource YipIndicatorTimerBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="10,0,8,0"
                           Opacity="0"
                           AutomationProperties.Name="Elapsed recording time" />

                <StackPanel x:Name="ExpandedActions"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                    <StackPanel.Resources>
                        <!-- Round glass buttons, as drawn in .design/Pill.dc.html. -->
                        <Style x:Key="PillActionButton" TargetType="Button">
                            <Setter Property="Width" Value="34" />
                            <Setter Property="Height" Value="34" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="CornerRadius" Value="17" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Background" Value="{ThemeResource YipIndicatorActionFillBrush}" />
                            <Setter Property="BorderBrush" Value="{ThemeResource YipIndicatorActionStrokeBrush}" />
                            <Setter Property="Foreground" Value="{ThemeResource YipIndicatorActionInkBrush}" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </StackPanel.Resources>
                    <Button x:Name="StopButton"
                            Style="{StaticResource PillActionButton}"
                            Click="OnStopClicked"
                            AutomationProperties.Name="Stop"
                            ToolTipService.ToolTip="Stop">
                        <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2"
                                   Fill="{ThemeResource YipIndicatorActionInkBrush}" />
                    </Button>
                    <Button x:Name="MarkButton"
                            Style="{StaticResource PillActionButton}"
                            Click="OnMarkClicked"
                            AutomationProperties.Name="Mark moment"
                            ToolTipService.ToolTip="Mark moment">
                        <!-- Three strokes: a waveform tick, not a generic glyph. -->
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Data="M12,4 L12,20 M6,9 L6,15 M18,9 L18,15"
                              Stroke="{ThemeResource YipIndicatorActionInkBrush}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <Button x:Name="OpenLastButton"
                            Style="{StaticResource PillActionButton}"
                            Click="OnOpenLastClicked"
                            AutomationProperties.Name="Open last recording"
                            ToolTipService.ToolTip="Open last recording">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE8B7;"
                                  FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
