namespace yip.viewmodels
{
    runtimeclass DeviceEntry
    {
        DeviceEntry();
        String Id;
        String Name;
        String Glyph;
        Boolean IsCapture;
        Boolean IsDefault;
    }

    [default_interface]
    runtimeclass RecordingEntry : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        RecordingEntry();
        String FullPath;
        String FileName;
        String Duration;
        String ModifiedAt;
        // "48 kHz · stereo · 32-bit float · 6.2 MB", read from the WAV header.
        String Subtitle;

        // Set by the view model on the one row that is loaded for playback, so
        // a filtered or scrolled list still says which take you are hearing.
        Boolean IsPlaying;
        // Play or pause glyph for that row, and 0 or 1 for its opacity. The
        // glyph keeps its space either way, so a row does not reflow when
        // playback starts.
        String PlayGlyph{ get; };
        Double PlayingOpacity{ get; };
    }

    [default_interface]
    runtimeclass MainViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        MainViewModel();

        Windows.Foundation.Collections.IObservableVector<DeviceEntry> Devices{ get; };
        Windows.Foundation.Collections.IObservableVector<RecordingEntry> Recordings{ get; };

        Int32 SelectedDeviceIndex;

        // Meter readings, already mapped onto the logarithmic meter scale
        // (0 = YipMeterFloorDb, 1 = full scale) so the view just draws them.
        Single MeterRms{ get; };
        Single MeterPeak{ get; };
        Single MeterHold{ get; };
        String PeakLabel{ get; };
        String RmsLabel{ get; };
        Boolean HasClipped{ get; };
        UInt32 DropoutCount{ get; };
        Boolean HasDropouts{ get; };

        // "00:00.0" while short, "1:02:03.4" past an hour.
        String ElapsedText{ get; };

        String StatusText{ get; };
        String ErrorText{ get; };
        Boolean HasError{ get; };

        String RecordButtonText{ get; };
        Microsoft.UI.Xaml.Media.Brush RecordButtonBrush{ get; };
        Boolean CanRecord{ get; };
        Boolean IsRecording{ get; };

        String OutputFolder{ get; };
        UInt32 SampleRate{ get; };
        UInt16 Channels{ get; };

        // Recording format: 0 WAV, 1 FLAC, 2 MP3, 3 M4A (audio-core's REC_FORMAT_*).
        // BitDepth applies to WAV and FLAC, BitrateKbps to MP3 and M4A.
        UInt16 Format{ get; };
        UInt16 BitDepth{ get; };
        UInt16 BitrateKbps{ get; };

        // "48 kHz · stereo · WAV 32-bit float" - what the next take will be.
        String FormatLabel{ get; };

        // Win32 MOD_* bitmask + virtual-key code for the global record hotkey.
        UInt32 HotkeyMods{ get; };
        UInt32 HotkeyVk{ get; };
        String HotkeyLabel{ get; };

        // Recording indicator: recording light only, and bottom-of-screen.
        Boolean PillDot{ get; };
        Boolean PillBottom{ get; };

        // Free-text filter over the recordings list. Setting it re-projects the
        // cached scan rather than re-reading the folder.
        String FilterText;
        Boolean IsEmpty{ get; };
        String RecordingsSummary{ get; };

        void RefreshDevices();
        void RefreshRecordings();

        // One poll of audio-core's meter snapshot. Replaces the old per-value
        // getters; costs a single FFI call.
        void Tick();

        void ToggleRecording();
        void ApplySettings(String folder, UInt32 sampleRate, UInt16 channels,
                           UInt16 format, UInt16 bitDepth, UInt16 bitrateKbps,
                           UInt32 hotkeyMods, UInt32 hotkeyVk, Boolean pillDot, Boolean pillBottom);

        void RevealRecording(RecordingEntry entry);
        // Hand the take to whatever the shell has registered for it. Playback
        // itself is native — this is the escape hatch, not the main path.
        void OpenRecordingExternally(RecordingEntry entry);
        Boolean DeleteRecording(RecordingEntry entry);
        void CopyRecordingPath(RecordingEntry entry);

        // ----- playback -----
        // Clicking a row: start this take, or hold and release the one already
        // loaded. Everything below drives audio-core's play_* surface.
        void ActivateRecording(RecordingEntry entry);
        void PlayRecording(RecordingEntry entry);
        void TogglePlayback();
        void StopPlayback();
        void SeekPlayback(UInt64 positionMs);

        // The window is going away (closed to the tray). Audio stops and the
        // file is released, but the transport keeps the take, its position and
        // its duration, held — so the window comes back exactly as it left,
        // and play picks up from there.
        void SuspendPlayback();

        // One poll of audio-core's playback snapshot. Only runs while a take is
        // loaded; an idle Yip still ticks nothing.
        void PlaybackTick();

        // A take is loaded — playing or held. The transport is shown for this.
        Boolean IsPlaybackLoaded{ get; };
        // Loaded *and* backed by a running audio-core player. False for a take
        // kept by SuspendPlayback: nothing is open, so nothing needs polling.
        Boolean IsPlaybackLive{ get; };
        // Loaded and not held.
        Boolean IsPlaybackPlaying{ get; };
        String PlayingFileName{ get; };
        // "01:23" either side of the scrubber.
        String PlaybackPositionText{ get; };
        String PlaybackDurationText{ get; };
        // Milliseconds, as Double because that is what a Slider takes.
        Double PlaybackPositionMs{ get; };
        Double PlaybackDurationMs{ get; };
        // Render level on the capture meter's own logarithmic scale, as a
        // percentage because that is what a ProgressBar takes.
        Double PlaybackLevelPercent{ get; };

        // Reconcile the view model with audio-core's own state, for the paths
        // that end a session without going through ToggleRecording — the pill,
        // the tray, or a take that failed on its own, which this finalises
        // with rec_stop and reports as an error.
        void SyncRecordingState(Boolean recording);
        void ReportHotkeyConflict();

        // Drop the cached transport brushes so the next read resolves against
        // the theme dictionary that is now current.
        void InvalidateThemeBrushes();
        void DismissError();
        void AcknowledgeClip();
    }
}
