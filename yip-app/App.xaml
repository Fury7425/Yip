<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="yip.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Every colour in Yip lives in the theme dictionaries at the bottom of
        this file, including the ones only C++ reads: `yip::theme::Color()`
        resolves them by key so nothing is written twice. Geometry and motion
        constants that only code consumes are NOT mirrored here — the code owns
        those outright rather than pretending this file is their source.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================== Geometry ============================== -->
            <CornerRadius x:Key="YipCardCornerRadius">14</CornerRadius>
            <CornerRadius x:Key="YipControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="YipMeterCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="YipDialogCornerRadius">14</CornerRadius>
            <!-- Exactly half of YipPillHeight. WinUI does not clamp an oversized
                 radius to a capsule the way CSS does — it scales the corners
                 down proportionally, so 999 on a 152x30 box drew an ellipse. -->
            <x:Double x:Key="YipPillHeight">32</x:Double>
            <CornerRadius x:Key="YipPillCornerRadius">16</CornerRadius>

            <!-- Spacing scale. Every gap in the app is one of these five. -->
            <x:Double x:Key="YipSpaceXs">4</x:Double>
            <x:Double x:Key="YipSpaceSm">8</x:Double>
            <x:Double x:Key="YipSpaceMd">12</x:Double>
            <x:Double x:Key="YipSpaceLg">16</x:Double>
            <x:Double x:Key="YipSpaceXl">20</x:Double>

            <!-- ============================ Type scale ============================== -->
            <!-- Numerals (timer, dB, durations) are monospaced so digits do not
                 jitter as they change. Font names stay inline at each use site:
                 a FontFamily resource is not reliably constructible from XAML. -->
            <x:Double x:Key="YipFontTimer">46</x:Double>
            <x:Double x:Key="YipFontSection">13</x:Double>
            <x:Double x:Key="YipFontBody">14</x:Double>
            <x:Double x:Key="YipFontCaption">12</x:Double>
            <x:Double x:Key="YipFontMicro">10</x:Double>

            <!-- ========================= Level meter scale ========================== -->
            <!-- The meter is logarithmic: a linear-amplitude bar spends its whole
                 travel in the bottom fifth and tells you nothing. Position maps
                 dBFS over YipMeterFloorDb..0 onto 0..1; the gridlines in
                 MainWindow sit on the same curve. -->
            <x:Double x:Key="YipMeterFloorDb">-60</x:Double>
            <x:Double x:Key="YipWaveHeight">76</x:Double>

            <!-- ===================== Indicator pill (XAML-side) ===================== -->
            <!-- Only what the pill's XAML reads. Its state geometry (including
                 the capsule's own size and radius) and motion timings are
                 constants in IndicatorWindow.xaml.cpp. The padding is symmetric
                 on purpose: the readout centres itself inside it. -->
            <Thickness x:Key="YipIndicatorPadding">10,4,10,4</Thickness>

            <!-- ===================== Theme-aware surfaces ===================== -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Surfaces. A tint over the window backdrop, never a fill:
                         if one of these ever needs to be opaque, Mica has
                         stopped doing its job. -->
                    <SolidColorBrush x:Key="YipCardBrush"            Color="#FFFFFF" Opacity="0.78" />
                    <SolidColorBrush x:Key="YipCardStrokeBrush"      Color="#000000" Opacity="0.06" />
                    <SolidColorBrush x:Key="YipControlFillBrush"     Color="#FFFFFF" Opacity="0.70" />
                    <SolidColorBrush x:Key="YipControlStrokeBrush"   Color="#000000" Opacity="0.07" />

                    <!-- Text -->
                    <SolidColorBrush x:Key="YipTextPrimaryBrush"     Color="#0A0A0B" />
                    <SolidColorBrush x:Key="YipTextSecondaryBrush"   Color="#525866" />
                    <SolidColorBrush x:Key="YipTextTertiaryBrush"    Color="#6E7485" />

                    <!-- Meter + waveform -->
                    <SolidColorBrush x:Key="YipMeterTrackQuietBrush" Color="#000000" Opacity="0.05" />
                    <SolidColorBrush x:Key="YipMeterHoldBrush"       Color="#0A0A0B" Opacity="0.50" />
                    <SolidColorBrush x:Key="YipWaveRestBrush"        Color="#000000" Opacity="0.16" />
                    <SolidColorBrush x:Key="YipWaveBaselineBrush"    Color="#000000" Opacity="0.14" />
                    <SolidColorBrush x:Key="YipClipLitBrush"         Color="#E5484D" />

                    <!-- Meter gradient. Green until it matters, amber where
                         headroom gets thin, red at the top. Code reads these
                         stops to colour the waveform, so there is one ramp. -->
                    <LinearGradientBrush x:Key="YipMeterGradientBrush" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2FA84F" Offset="0.00" />
                        <GradientStop Color="#4FBF63" Offset="0.55" />
                        <GradientStop Color="#E0A33A" Offset="0.82" />
                        <GradientStop Color="#E5484D" Offset="0.94" />
                        <GradientStop Color="#E5484D" Offset="1.00" />
                    </LinearGradientBrush>

                    <!-- Transport -->
                    <SolidColorBrush x:Key="YipRecordFillIdleBrush"  Color="#E5484D" Opacity="0.22" />
                    <SolidColorBrush x:Key="YipRecordFillLiveBrush"  Color="#E5484D" Opacity="0.55" />
                    <SolidColorBrush x:Key="YipRecordStrokeBrush"    Color="#000000" Opacity="0.08" />
                    <SolidColorBrush x:Key="YipRecordCoreBrush"      Color="#D8353B" />
                    <SolidColorBrush x:Key="YipLampIdleBrush"        Color="#8A90A0" />
                    <SolidColorBrush x:Key="YipLampLiveBrush"        Color="#E5484D" />

                    <!-- Indicator pill -->
                    <!-- Two tints for the capsule (IndicatorWindow::ApplySurfaceTint).
                         Over its blur the tint only has to shade. With
                         transparency effects off there is no blur, and the
                         denser one carries legibility on its own. -->
                    <SolidColorBrush x:Key="YipIndicatorSurfaceBrush"      Color="#FAFAFB" Opacity="0.88" />
                    <SolidColorBrush x:Key="YipIndicatorSurfaceBlurredBrush" Color="#FAFAFB" Opacity="0.70" />
                    <SolidColorBrush x:Key="YipIndicatorStrokeQuietBrush"  Color="#000000" Opacity="0.07" />
                    <SolidColorBrush x:Key="YipIndicatorMeterBarIdleBrush" Color="#525866" />
                    <SolidColorBrush x:Key="YipIndicatorMeterBarLiveBrush" Color="#E5484D" />
                    <SolidColorBrush x:Key="YipIndicatorDotIdleBrush"      Color="#8A90A0" />
                    <SolidColorBrush x:Key="YipIndicatorDotLiveBrush"      Color="#E5484D" />
                    <SolidColorBrush x:Key="YipIndicatorTimerBrush"        Color="#0A0A0B" />
                    <SolidColorBrush x:Key="YipIndicatorActionFillBrush"   Color="#000000" Opacity="0.06" />
                    <SolidColorBrush x:Key="YipIndicatorActionStrokeBrush" Color="#000000" Opacity="0.07" />
                    <SolidColorBrush x:Key="YipIndicatorActionInkBrush"    Color="#525866" />

                    <!-- Dialogs. A ContentDialog floats over the window's own
                         content, so it cannot be a tint: it is the one opaque
                         surface, kept in the same family as the cards. -->
                    <SolidColorBrush x:Key="YipGroupBrush"                 Color="#000000" Opacity="0.03" />
                    <SolidColorBrush x:Key="ContentDialogTopOverlay"       Color="#FBFBFC" />
                    <SolidColorBrush x:Key="ContentDialogBackground"       Color="#F1F2F4" />
                    <SolidColorBrush x:Key="ContentDialogBorderBrush"      Color="#000000" Opacity="0.08" />

                    <!-- Lightweight overrides for the stock text box and combo
                         box, so hover and focus stay glass instead of dropping
                         to the default opaque fill. -->
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver"          Color="#FFFFFF" Opacity="0.85" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused"              Color="#FFFFFF" Opacity="0.95" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground"          Color="#6E7485" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#6E7485" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused"   Color="#8A90A0" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver"             Color="#FFFFFF" Opacity="0.85" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed"                 Color="#FFFFFF" Opacity="0.60" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="YipCardBrush"            Color="#0B0C11" Opacity="0.42" />
                    <SolidColorBrush x:Key="YipCardStrokeBrush"      Color="#FFFFFF" Opacity="0.075" />
                    <SolidColorBrush x:Key="YipControlFillBrush"     Color="#FFFFFF" Opacity="0.10" />
                    <SolidColorBrush x:Key="YipControlStrokeBrush"   Color="#FFFFFF" Opacity="0.055" />

                    <SolidColorBrush x:Key="YipTextPrimaryBrush"     Color="#F2F3F5" />
                    <SolidColorBrush x:Key="YipTextSecondaryBrush"   Color="#C9CED8" />
                    <SolidColorBrush x:Key="YipTextTertiaryBrush"    Color="#9BA2B2" />

                    <SolidColorBrush x:Key="YipMeterTrackQuietBrush" Color="#000000" Opacity="0.34" />
                    <SolidColorBrush x:Key="YipMeterHoldBrush"       Color="#FFFFFF" Opacity="0.55" />
                    <SolidColorBrush x:Key="YipWaveRestBrush"        Color="#FFFFFF" Opacity="0.13" />
                    <SolidColorBrush x:Key="YipWaveBaselineBrush"    Color="#FFFFFF" Opacity="0.11" />
                    <SolidColorBrush x:Key="YipClipLitBrush"         Color="#FF6B70" />

                    <LinearGradientBrush x:Key="YipMeterGradientBrush" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#35C46A" Offset="0.00" />
                        <GradientStop Color="#5BD167" Offset="0.55" />
                        <GradientStop Color="#F0BE52" Offset="0.82" />
                        <GradientStop Color="#FF6B70" Offset="0.94" />
                        <GradientStop Color="#FF6B70" Offset="1.00" />
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="YipRecordFillIdleBrush"  Color="#E5484D" Opacity="0.28" />
                    <SolidColorBrush x:Key="YipRecordFillLiveBrush"  Color="#E5484D" Opacity="0.60" />
                    <SolidColorBrush x:Key="YipRecordStrokeBrush"    Color="#FFFFFF" Opacity="0.10" />
                    <SolidColorBrush x:Key="YipRecordCoreBrush"      Color="#FFF2F2" />
                    <SolidColorBrush x:Key="YipLampIdleBrush"        Color="#767C8C" />
                    <SolidColorBrush x:Key="YipLampLiveBrush"        Color="#E5484D" />

                    <SolidColorBrush x:Key="YipIndicatorSurfaceBrush"      Color="#141518" Opacity="0.84" />
                    <SolidColorBrush x:Key="YipIndicatorSurfaceBlurredBrush" Color="#141518" Opacity="0.66" />
                    <SolidColorBrush x:Key="YipIndicatorStrokeQuietBrush"  Color="#FFFFFF" Opacity="0.075" />
                    <SolidColorBrush x:Key="YipIndicatorMeterBarIdleBrush" Color="#B7BCC8" />
                    <SolidColorBrush x:Key="YipIndicatorMeterBarLiveBrush" Color="#FF6B70" />
                    <SolidColorBrush x:Key="YipIndicatorDotIdleBrush"      Color="#767C8C" />
                    <SolidColorBrush x:Key="YipIndicatorDotLiveBrush"      Color="#E5484D" />
                    <SolidColorBrush x:Key="YipIndicatorTimerBrush"        Color="#F2F3F5" />
                    <SolidColorBrush x:Key="YipIndicatorActionFillBrush"   Color="#FFFFFF" Opacity="0.07" />
                    <SolidColorBrush x:Key="YipIndicatorActionStrokeBrush" Color="#FFFFFF" Opacity="0.07" />
                    <SolidColorBrush x:Key="YipIndicatorActionInkBrush"    Color="#C9CED8" />

                    <SolidColorBrush x:Key="YipGroupBrush"                 Color="#FFFFFF" Opacity="0.035" />
                    <SolidColorBrush x:Key="ContentDialogTopOverlay"       Color="#1E1F25" />
                    <SolidColorBrush x:Key="ContentDialogBackground"       Color="#17181D" />
                    <SolidColorBrush x:Key="ContentDialogBorderBrush"      Color="#FFFFFF" Opacity="0.08" />

                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver"          Color="#FFFFFF" Opacity="0.14" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused"              Color="#000000" Opacity="0.30" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground"          Color="#9BA2B2" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#9BA2B2" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused"   Color="#767C8C" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver"             Color="#FFFFFF" Opacity="0.14" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed"                 Color="#FFFFFF" Opacity="0.07" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
