<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="yip.IndicatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root" Background="Transparent">
        <!--
            The pill's surface. Nothing in XAML draws a capsule: every shape
            (the capsule or lamp disc, the Pause and Stop discs, and the edge
            and neck the entrance drips from) is a composition geometry, and
            one goo effect over all of them paints this host's child visual.
            Shapes near each other melt together; that is the whole effect.
        -->
        <Border x:Name="GooHost" IsHitTestVisible="False" />

        <!--
            Content and hit targets only. IndicatorWindow::PlaceContent puts
            each element where its shape comes to rest; while a shape moves,
            an expression keeps the element's composition Translation on the
            shape's centre, so no layout pass runs per frame.
        -->
        <Canvas x:Name="PillCanvas">
            <Canvas.Resources>
                <!-- The discs are the buttons' surface; the Button template
                     only adds a hover and press tint on top of them. -->
                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="YipIndicatorActionFillBrush" />
                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="YipIndicatorActionFillBrush" />
                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="YipIndicatorActionInkBrush" />
                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="YipIndicatorActionInkBrush" />
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                <Style x:Key="PillActionButton" TargetType="Button">
                    <Setter Property="Width" Value="40" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="CornerRadius" Value="20" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{ThemeResource YipIndicatorActionInkBrush}" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </Canvas.Resources>

            <!-- The capsule (pill style) or lamp disc (dot style): a tap
                 target the size of its shape, with the readout centred in it. -->
            <Border
                x:Name="PillFrame"
                Background="Transparent"
                PointerPressed="OnPillPointerPressed"
                Tapped="OnPillTapped">
                <!-- Dot, meter and clock travel as one group. In the dot style
                     the detail collapses and the lamp is all there is. -->
                <StackPanel x:Name="ReadoutGroup"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <!-- Dot host — its Visual receives a SpriteVisual fill. -->
                    <Border x:Name="DotHost"
                            Width="12" Height="12"
                            VerticalAlignment="Center" />

                    <StackPanel x:Name="ReadoutDetail"
                                Orientation="Horizontal"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                        <!-- Meter host — 4 bars appended as child visuals. Exactly as
                             wide as the bars, or the group centres off to one side. -->
                        <Border x:Name="MeterHost"
                                Width="24" Height="22"
                                VerticalAlignment="Center" />

                        <!-- Elapsed time. The pill is often the only thing on screen
                             while recording, so it answers "how long has this been
                             running" without opening the main window. -->
                        <TextBlock x:Name="ElapsedText"
                                   Text="00:00"
                                   FontFamily="Cascadia Mono,Consolas,Courier New"
                                   FontSize="13"
                                   Foreground="{ThemeResource YipIndicatorTimerBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   AutomationProperties.Name="Elapsed recording time" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Hold before stop: pausing is the recoverable one, so it takes
                 the inner slot, and the irreversible button sits further out.
                 Each rides its own disc, which splits off the capsule. -->
            <Button x:Name="PauseButton"
                    Style="{StaticResource PillActionButton}"
                    Visibility="Collapsed"
                    Click="OnPauseClicked"
                    AutomationProperties.Name="Pause"
                    ToolTipService.ToolTip="Pause">
                <FontIcon x:Name="PauseGlyph"
                          FontFamily="Segoe Fluent Icons"
                          Glyph="&#xE769;"
                          FontSize="13" />
            </Button>
            <Button x:Name="StopButton"
                    Style="{StaticResource PillActionButton}"
                    Visibility="Collapsed"
                    Click="OnStopClicked"
                    AutomationProperties.Name="Stop"
                    ToolTipService.ToolTip="Stop">
                <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2"
                           Fill="{ThemeResource YipIndicatorActionInkBrush}" />
            </Button>
        </Canvas>
    </Grid>
</Window>
