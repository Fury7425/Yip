// Version resource for yip-app.exe.
//
// An executable with no VERSIONINFO block is one of the things Defender's
// heuristics weigh against an unsigned binary, and it is also just wrong: the
// shell's Properties > Details page was blank. Keep the numbers in step with
// project(yip VERSION ...) in CMakeLists.txt and the version passed to ISCC.

#include <winver.h>

#include "resource.h"

// Application icon. Built from the hand-tuned SVGs in .design/icons by
// .design/icons/make-ico.ps1 — edit those and re-run it, never the .ico.
IDI_YIP_APP ICON "Assets\\yip.ico"

#define YIP_VERSION_MAJOR 0
#define YIP_VERSION_MINOR 1
#define YIP_VERSION_PATCH 0
#define YIP_VERSION_BUILD 0

#define YIP_VERSION_STR "0.1.0.0"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    YIP_VERSION_MAJOR, YIP_VERSION_MINOR, YIP_VERSION_PATCH, YIP_VERSION_BUILD
    PRODUCTVERSION YIP_VERSION_MAJOR, YIP_VERSION_MINOR, YIP_VERSION_PATCH, YIP_VERSION_BUILD
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS      VS_FF_DEBUG
#else
    FILEFLAGS      0x0L
#endif
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"   // US English, Unicode
        BEGIN
            VALUE "CompanyName",      "Yip contributors"
            VALUE "FileDescription",  "Yip audio recorder"
            VALUE "FileVersion",      YIP_VERSION_STR
            VALUE "InternalName",     "yip-app"
            VALUE "LegalCopyright",   "Copyright (C) Yip contributors"
            VALUE "OriginalFilename", "yip-app.exe"
            VALUE "ProductName",      "Yip"
            VALUE "ProductVersion",   YIP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
