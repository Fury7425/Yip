<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="yip.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:yip.viewmodels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <!-- Mica puts the desktop tint behind the app, which is what makes an
         unpackaged WinUI window read as part of Windows rather than a box
         floating on top of it. Nothing below paints an opaque background. -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnRecordAccelerator" />
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="OnProcessAccelerator" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAccelerator" />
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Title bar =====================
             The whole strip is the drag region. App actions sit on the right
             with an inset the code-behind widens to clear the system caption
             buttons; the 140px default keeps them clear even if the inset
             cannot be read yet. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44" Background="Transparent"
              Padding="18,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <!-- The mark doubles as the recording lamp: it is the one thing
                     visible no matter how the window is sized. -->
                <Ellipse x:Name="TitleLamp" Width="8" Height="8"
                         Fill="{ThemeResource YipTextTertiaryBrush}" />
                <TextBlock Text="Yip"
                           FontSize="{StaticResource YipFontBody}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource YipTextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="TitleBarActions" Grid.Column="2" Orientation="Horizontal"
                        Spacing="2" Margin="0,0,140,0" VerticalAlignment="Center">
                <Button x:Name="ProcessButton" Click="OnOpenProcess"
                        Background="Transparent" BorderThickness="0" Padding="9,6"
                        AutomationProperties.Name="Process with VST3"
                        ToolTipService.ToolTip="Process with VST3 (Ctrl+P)">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9F5;" FontSize="15" />
                </Button>
                <Button x:Name="SettingsButton" Click="OnOpenSettings"
                        Background="Transparent" BorderThickness="0" Padding="9,6"
                        AutomationProperties.Name="Settings"
                        ToolTipService.ToolTip="Settings">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="15" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== Error surface =====================
             Failures used to land in the same 55%-opacity grey line as "Ready",
             which is where messages go to be missed. -->
        <InfoBar x:Name="ErrorBar"
                 Grid.Row="1"
                 Severity="Error"
                 IsOpen="False"
                 IsIconVisible="True"
                 Margin="20,0,20,12"
                 Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                 CloseButtonClick="OnDismissError" />

        <!-- ===================== Transport =====================  -->
        <Border Grid.Row="2"
                Margin="20,4,20,0"
                Padding="18,16,18,16"
                CornerRadius="{StaticResource YipCardCornerRadius}"
                Background="{ThemeResource YipCardBrush}"
                BorderBrush="{ThemeResource YipCardStrokeBrush}"
                BorderThickness="1">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Timer + readouts -->
                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ElapsedLabel"
                               Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}"
                               FontFamily="Cascadia Mono,Consolas,Courier New"
                               FontSize="{StaticResource YipFontTimer}"
                               FontWeight="SemiLight"
                               Foreground="{ThemeResource YipTextPrimaryBrush}"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="Elapsed recording time" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14"
                                VerticalAlignment="Center">
                        <StackPanel Spacing="1">
                            <TextBlock Text="PEAK"
                                       FontSize="{StaticResource YipFontMicro}"
                                       CharacterSpacing="80"
                                       Foreground="{ThemeResource YipTextTertiaryBrush}"
                                       TextAlignment="Right" />
                            <TextBlock Text="{x:Bind ViewModel.PeakLabel, Mode=OneWay}"
                                       FontFamily="Cascadia Mono,Consolas,Courier New"
                                       FontSize="{StaticResource YipFontCaption}"
                                       Foreground="{ThemeResource YipTextSecondaryBrush}"
                                       TextAlignment="Right"
                                       MinWidth="66" />
                        </StackPanel>

                        <!-- Clip lamp. Dim red at rest, lit once a sample hits
                             full scale; click to acknowledge. -->
                        <StackPanel x:Name="ClipLamp" Spacing="3" Opacity="0.18"
                                    Tapped="OnAcknowledgeClip"
                                    ToolTipService.ToolTip="Clipping detected. Click to reset."
                                    AutomationProperties.Name="Clip indicator">
                            <Border Width="26" Height="4" CornerRadius="2"
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource YipClipLitBrush}" />
                            <TextBlock Text="CLIP"
                                       FontSize="{StaticResource YipFontMicro}"
                                       CharacterSpacing="80"
                                       Foreground="{ThemeResource YipClipLitBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Level meter. Three stacked layers, each clipped rather than
                     resized, so a tick costs no layout pass:
                       track  - the full travel
                       peak   - decaying envelope, ghosted
                       rms    - smoothed loudness, solid
                     plus a peak-hold marker that falls back slowly. -->
                <Grid Grid.Row="1" x:Name="MeterHost"
                      Height="{StaticResource YipMeterHeight}"
                      SizeChanged="OnMeterSizeChanged"
                      AutomationProperties.Name="Input level">
                    <Border CornerRadius="{StaticResource YipMeterCornerRadius}"
                            Background="{ThemeResource YipMeterTrackQuietBrush}" />
                    <Rectangle x:Name="PeakBar"
                               RadiusX="4" RadiusY="4"
                               Opacity="0.30"
                               Fill="{ThemeResource YipMeterGradientBrush}">
                        <Rectangle.Clip>
                            <RectangleGeometry x:Name="PeakClip" Rect="0,0,0,10" />
                        </Rectangle.Clip>
                    </Rectangle>
                    <Rectangle x:Name="RmsBar"
                               RadiusX="4" RadiusY="4"
                               Fill="{ThemeResource YipMeterGradientBrush}">
                        <Rectangle.Clip>
                            <RectangleGeometry x:Name="RmsClip" Rect="0,0,0,10" />
                        </Rectangle.Clip>
                    </Rectangle>
                    <Rectangle x:Name="HoldMark"
                               Width="{StaticResource YipMeterHoldWidth}"
                               HorizontalAlignment="Left"
                               Opacity="0"
                               Fill="{ThemeResource YipMeterHoldBrush}">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="HoldTranslate" X="0" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>

                <!-- dBFS scale. Labels are right-aligned at their column edge,
                     and the columns are sized on the same log curve the bar
                     uses, so a label sits exactly at its level. -->
                <Grid Grid.Row="2" Margin="0,-6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="-48" HorizontalAlignment="Right"
                               FontSize="{StaticResource YipFontMicro}"
                               Foreground="{ThemeResource YipTextTertiaryBrush}" />
                    <TextBlock Grid.Column="1" Text="-24" HorizontalAlignment="Right"
                               FontSize="{StaticResource YipFontMicro}"
                               Foreground="{ThemeResource YipTextTertiaryBrush}" />
                    <TextBlock Grid.Column="2" Text="-12" HorizontalAlignment="Right"
                               FontSize="{StaticResource YipFontMicro}"
                               Foreground="{ThemeResource YipTextTertiaryBrush}" />
                    <TextBlock Grid.Column="3" Text="-6" HorizontalAlignment="Right"
                               FontSize="{StaticResource YipFontMicro}"
                               Foreground="{ThemeResource YipTextTertiaryBrush}" />
                    <TextBlock Grid.Column="4" Text="0" HorizontalAlignment="Right"
                               FontSize="{StaticResource YipFontMicro}"
                               Foreground="{ThemeResource YipTextTertiaryBrush}" />
                </Grid>

                <!-- Device + record -->
                <Grid Grid.Row="3" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        x:Name="DeviceCombo"
                        PlaceholderText="Select input device"
                        HorizontalAlignment="Stretch"
                        MinWidth="220"
                        Height="36"
                        CornerRadius="{StaticResource YipControlCornerRadius}"
                        ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedDeviceIndex, Mode=TwoWay}"
                        AutomationProperties.Name="Input device">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceEntry">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0"
                                              FontFamily="Segoe Fluent Icons"
                                              Glyph="{x:Bind Glyph}"
                                              FontSize="14"
                                              VerticalAlignment="Center"
                                              Opacity="0.8" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button
                        x:Name="RecordButton"
                        Grid.Column="1"
                        MinWidth="132"
                        Height="36"
                        CornerRadius="{StaticResource YipControlCornerRadius}"
                        Click="OnRecordToggle"
                        Background="{x:Bind ViewModel.RecordButtonBrush, Mode=OneWay}"
                        Foreground="White"
                        BorderThickness="0"
                        IsEnabled="{x:Bind ViewModel.CanRecord, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.HotkeyLabel, Mode=OneWay}"
                        AutomationProperties.Name="Start or stop recording">
                        <StackPanel Orientation="Horizontal" Spacing="9"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="11" Height="11" VerticalAlignment="Center">
                                <Ellipse x:Name="RecordDot" Fill="White" />
                                <Rectangle x:Name="StopSquare" Fill="White"
                                           Width="9" Height="9" RadiusX="1" RadiusY="1"
                                           Visibility="Collapsed" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.RecordButtonText, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- ===================== Recordings ===================== -->
        <Border Grid.Row="3"
                Margin="20,12,20,0"
                CornerRadius="{StaticResource YipCardCornerRadius}"
                Background="{ThemeResource YipCardBrush}"
                BorderBrush="{ThemeResource YipCardStrokeBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="14,10,10,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Recordings"
                                   FontSize="{StaticResource YipFontSection}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource YipTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.RecordingsSummary, Mode=OneWay}"
                                   FontSize="{StaticResource YipFontCaption}"
                                   Foreground="{ThemeResource YipTextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="2"
                             Width="168"
                             Height="30"
                             CornerRadius="{StaticResource YipControlCornerRadius}"
                             PlaceholderText="Filter"
                             TextChanged="OnFilterChanged"
                             AutomationProperties.Name="Filter recordings"
                             ToolTipService.ToolTip="Filter recordings (Ctrl+F)" />

                    <Button Grid.Column="3" Click="OnRefreshList"
                            Background="Transparent" BorderThickness="0" Padding="8,6"
                            AutomationProperties.Name="Refresh"
                            ToolTipService.ToolTip="Refresh (F5)">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <ListView
                        x:Name="RecordingsList"
                        ItemsSource="{x:Bind ViewModel.Recordings, Mode=OneWay}"
                        SelectionMode="Single"
                        Padding="6,0,6,8"
                        AutomationProperties.Name="Recordings">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Margin" Value="0,1,0,1" />
                                <Setter Property="Padding" Value="10,6,10,6" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecordingEntry">
                                <Grid ColumnSpacing="12" Background="Transparent"
                                      DoubleTapped="OnRecordingActivated">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Play" Click="OnPlayItem">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE768;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Show in Explorer" Click="OnRevealItem">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xEC50;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Copy path" Click="OnCopyPathItem">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8C8;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Delete" Click="OnDeleteItem">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind FileName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="{StaticResource YipFontBody}" />
                                        <TextBlock Text="{x:Bind Subtitle}"
                                                   FontSize="{StaticResource YipFontMicro}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource YipTextTertiaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="2" MinWidth="86">
                                        <TextBlock Text="{x:Bind Duration}"
                                                   FontFamily="Cascadia Mono,Consolas,Courier New"
                                                   FontSize="{StaticResource YipFontCaption}"
                                                   TextAlignment="Right"
                                                   Foreground="{ThemeResource YipTextSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ModifiedAt}"
                                                   FontSize="{StaticResource YipFontMicro}"
                                                   TextAlignment="Right"
                                                   Foreground="{ThemeResource YipTextTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state. Told apart from "filtered to nothing" by
                         the code-behind, which swaps the message. -->
                    <StackPanel x:Name="EmptyState"
                                Spacing="6"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D6;" FontSize="22"
                                  Foreground="{ThemeResource YipTextTertiaryBrush}" />
                        <TextBlock x:Name="EmptyStateText"
                                   Text="No recordings yet"
                                   FontSize="{StaticResource YipFontCaption}"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource YipTextSecondaryBrush}" />
                        <TextBlock x:Name="EmptyStateHint"
                                   Text="Press Record to make one."
                                   FontSize="{StaticResource YipFontMicro}"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource YipTextTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ===================== Status bar ===================== -->
        <Grid Grid.Row="4" Padding="22,10,22,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StatusLine"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                FontSize="{StaticResource YipFontCaption}"
                TextTrimming="CharacterEllipsis"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource YipTextSecondaryBrush}" />
            <TextBlock
                Grid.Column="1"
                Text="{x:Bind ViewModel.HotkeyLabel, Mode=OneWay}"
                FontFamily="Cascadia Mono,Consolas,Courier New"
                FontSize="{StaticResource YipFontMicro}"
                ToolTipService.ToolTip="Global record hotkey"
                Foreground="{ThemeResource YipTextTertiaryBrush}" />
        </Grid>
    </Grid>
</Window>
