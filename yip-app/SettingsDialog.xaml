<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="yip.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    Title="Settings"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="{StaticResource YipDialogCornerRadius}">

    <!-- Grouped the way the main window is: quiet section labels over tinted
         groups, pill-radius-free controls at the shared 8px control radius.
         The dialog opens inside a 470 DIP window, so the content caps its own
         width and every explanatory line wraps — a single unwrapped hint used
         to push the content past the dialog edge and clip Browse and Reset. -->
    <ContentDialog.Resources>
        <Style x:Key="SettingsSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="Margin" Value="2,6,0,0" />
            <Setter Property="Foreground" Value="{ThemeResource YipTextTertiaryBrush}" />
        </Style>
        <Style x:Key="SettingsGroup" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource YipGroupBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource YipCardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12,14,12" />
        </Style>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource YipTextPrimaryBrush}" />
        </Style>
        <Style x:Key="SettingsHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource YipTextTertiaryBrush}" />
        </Style>
        <Style x:Key="SettingsDivider" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{ThemeResource YipCardStrokeBrush}" />
        </Style>
    </ContentDialog.Resources>

    <!-- ContentDialog's own content ScrollViewer has scrolling disabled, so it
         hands this one a bounded height: once the groups outgrow the dialog
         they scroll here instead of being cut off. The right padding keeps the
         overlay scrollbar off the groups' borders. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,12,0">
        <StackPanel Spacing="8" MaxWidth="376">
            <!-- ===================== Recording ===================== -->
            <TextBlock Text="RECORDING" Style="{StaticResource SettingsSection}" />

            <Border Style="{StaticResource SettingsGroup}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Save recordings to" Style="{StaticResource SettingsLabel}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox"
                                 CornerRadius="{StaticResource YipControlCornerRadius}"
                                 PlaceholderText="C:\Users\You\Music\Yip"
                                 AutomationProperties.Name="Output folder" />
                        <Button Grid.Column="1"
                                Click="OnPickFolder"
                                Content="Browse…"
                                CornerRadius="{StaticResource YipControlCornerRadius}" />
                    </Grid>
                    <TextBlock x:Name="FolderHint"
                               Style="{StaticResource SettingsHint}"
                               Text="Created automatically if it does not exist." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsGroup}">
                <Grid RowSpacing="10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Sample rate" Style="{StaticResource SettingsLabel}" />
                        <TextBlock Style="{StaticResource SettingsHint}"
                                   Text="Uses the device rate if the input refuses this one." />
                    </StackPanel>
                    <ComboBox x:Name="SampleRateCombo"
                              Grid.Column="1"
                              Width="128"
                              VerticalAlignment="Center"
                              SelectedIndex="1"
                              CornerRadius="{StaticResource YipControlCornerRadius}"
                              AutomationProperties.Name="Sample rate">
                        <ComboBoxItem Content="44.1 kHz" Tag="44100" />
                        <ComboBoxItem Content="48 kHz" Tag="48000" />
                        <ComboBoxItem Content="88.2 kHz" Tag="88200" />
                        <ComboBoxItem Content="96 kHz" Tag="96000" />
                    </ComboBox>

                    <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource SettingsDivider}" />

                    <TextBlock Grid.Row="2" Text="Channels" Style="{StaticResource SettingsLabel}" />
                    <ComboBox x:Name="ChannelsCombo"
                              Grid.Row="2"
                              Grid.Column="1"
                              Width="128"
                              VerticalAlignment="Center"
                              SelectedIndex="1"
                              CornerRadius="{StaticResource YipControlCornerRadius}"
                              AutomationProperties.Name="Channels">
                        <ComboBoxItem Content="Mono" Tag="1" />
                        <ComboBoxItem Content="Stereo" Tag="2" />
                    </ComboBox>

                    <Rectangle Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource SettingsDivider}" />

                    <!-- Item order is the format value (audio-core's REC_FORMAT_*). -->
                    <StackPanel Grid.Row="4" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Format" Style="{StaticResource SettingsLabel}" />
                        <TextBlock x:Name="FormatHint"
                                   Style="{StaticResource SettingsHint}"
                                   Text="Uncompressed. The largest files, and no quality loss." />
                    </StackPanel>
                    <ComboBox x:Name="FormatCombo"
                              Grid.Row="4"
                              Grid.Column="1"
                              Width="128"
                              VerticalAlignment="Center"
                              SelectedIndex="0"
                              SelectionChanged="OnFormatChanged"
                              CornerRadius="{StaticResource YipControlCornerRadius}"
                              AutomationProperties.Name="Format">
                        <ComboBoxItem Content="WAV" />
                        <ComboBoxItem Content="FLAC" />
                        <ComboBoxItem Content="MP3" />
                        <ComboBoxItem Content="M4A (AAC)" />
                    </ComboBox>

                    <Rectangle Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource SettingsDivider}" />

                    <!-- One cell, two pickers: bit depth for WAV and FLAC, bitrate for
                         MP3 and M4A. The code-behind swaps them and disables what the
                         chosen codec cannot do. -->
                    <TextBlock x:Name="QualityLabel"
                               Grid.Row="6"
                               Text="Bit depth"
                               Style="{StaticResource SettingsLabel}" />
                    <ComboBox x:Name="BitDepthCombo"
                              Grid.Row="6"
                              Grid.Column="1"
                              Width="128"
                              VerticalAlignment="Center"
                              SelectedIndex="2"
                              CornerRadius="{StaticResource YipControlCornerRadius}"
                              AutomationProperties.Name="Bit depth">
                        <ComboBoxItem Content="16-bit" Tag="16" />
                        <ComboBoxItem Content="24-bit" Tag="24" />
                        <ComboBoxItem Content="32-bit float" Tag="32" />
                    </ComboBox>
                    <ComboBox x:Name="BitrateCombo"
                              Grid.Row="6"
                              Grid.Column="1"
                              Width="128"
                              VerticalAlignment="Center"
                              SelectedIndex="3"
                              Visibility="Collapsed"
                              CornerRadius="{StaticResource YipControlCornerRadius}"
                              AutomationProperties.Name="Bitrate">
                        <ComboBoxItem Content="96 kbps" Tag="96" />
                        <ComboBoxItem Content="128 kbps" Tag="128" />
                        <ComboBoxItem Content="160 kbps" Tag="160" />
                        <ComboBoxItem Content="192 kbps" Tag="192" />
                        <ComboBoxItem Content="256 kbps" Tag="256" />
                        <ComboBoxItem Content="320 kbps" Tag="320" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- ===================== Indicator ===================== -->
            <TextBlock Text="INDICATOR" Style="{StaticResource SettingsSection}" />

            <Border Style="{StaticResource SettingsGroup}">
                <Grid RowSpacing="10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Style" Style="{StaticResource SettingsLabel}" />
                        <TextBlock Style="{StaticResource SettingsHint}"
                                   Text="Dot shows only the recording light. Click it for the timer and controls." />
                    </StackPanel>
                    <ComboBox x:Name="PillStyleCombo"
                              Grid.Column="1"
                              Width="128"
                              VerticalAlignment="Center"
                              SelectedIndex="0"
                              CornerRadius="{StaticResource YipControlCornerRadius}"
                              AutomationProperties.Name="Indicator style">
                        <ComboBoxItem Content="Pill" />
                        <ComboBoxItem Content="Dot" />
                    </ComboBox>

                    <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource SettingsDivider}" />

                    <TextBlock Grid.Row="2" Text="Position" Style="{StaticResource SettingsLabel}" />
                    <ComboBox x:Name="PillEdgeCombo"
                              Grid.Row="2"
                              Grid.Column="1"
                              Width="128"
                              VerticalAlignment="Center"
                              SelectedIndex="0"
                              CornerRadius="{StaticResource YipControlCornerRadius}"
                              AutomationProperties.Name="Indicator position">
                        <ComboBoxItem Content="Top" />
                        <ComboBoxItem Content="Bottom" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- ===================== Shortcut ===================== -->
            <TextBlock Text="SHORTCUT" Style="{StaticResource SettingsSection}" />

            <Border Style="{StaticResource SettingsGroup}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Start and stop recording" Style="{StaticResource SettingsLabel}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HotkeyBox"
                                 IsReadOnly="True"
                                 IsSpellCheckEnabled="False"
                                 FontFamily="Cascadia Mono,Consolas,Courier New"
                                 CornerRadius="{StaticResource YipControlCornerRadius}"
                                 PreviewKeyDown="OnHotkeyKeyDown"
                                 PlaceholderText="Click, then press the keys"
                                 AutomationProperties.Name="Global record hotkey" />
                        <Button Grid.Column="1"
                                Click="OnResetHotkey"
                                Content="Reset"
                                CornerRadius="{StaticResource YipControlCornerRadius}" />
                    </Grid>
                    <TextBlock x:Name="HotkeyHint"
                               Style="{StaticResource SettingsHint}"
                               Text="Works while Yip is in the background. Needs Ctrl, Alt, Shift or Win." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
